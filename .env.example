# Copia este archivo a .env para desarrollo local.
#
# OJO: Vite hornea estas variables en el bundle durante `npm run build`, no las
# lee en tiempo de ejecución. Cambiar la URL de la API en producción obliga a
# reconstruir la imagen, no basta con editar una variable en el servidor.
#
# Nunca pongas secretos aquí: todo lo que empiece por VITE_ acaba siendo
# visible en el navegador.

# URL base de la API, incluyendo /api.
# Desarrollo: se puede omitir; por defecto usa http://localhost:3000/api
# Producción: VITE_API_URL=https://api.micongrega.cloud/api
VITE_API_URL=http://localhost:3000/api
